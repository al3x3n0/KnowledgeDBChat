# Root .env — read automatically by docker compose (and by `make health` /
# scripts/check_health.sh, which resolve the same names).
#
# Copy to .env and edit. Nothing here is required: every value below is the
# default already baked into the compose files.

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------
# Only the HOST side of each mapping. Containers keep their conventional ports
# and talk to each other by service name, so changing these never touches
# inter-service wiring.
#
# The scheme is "2" + the service's conventional port: 5432 -> 25432,
# 8000 -> 28000, 3000 -> 23000. That keeps each one guessable while avoiding
# the conventional ports, which every other project on a laptop also wants.
#
# 1xxxx was the first choice and was wrong: a co-resident project already held
# 19000, 18081 and 15433, so the whole 1-prefixed range is contested here.
# Check before moving into a range -- `docker ps --format '{{.Names}}\t{{.Ports}}'`
# and `lsof -nP -iTCP -sTCP:LISTEN` show what is actually taken.
#
# Move any of these if something still collides; the docs, health checks and
# CORS defaults all resolve the same names, so they follow along.

KDBC_UI_PORT=23000            # nginx: the web app. This is the one you open.
KDBC_BACKEND_PORT=28000       # FastAPI direct (the UI itself goes via nginx)
KDBC_MERMAID_PORT=28001       # mermaid-renderer
KDBC_VIDEO_PORT=28080         # video-streamer
KDBC_POSTGRES_PORT=25432
KDBC_REDIS_PORT=26379
KDBC_QDRANT_PORT=26333
KDBC_MINIO_PORT=29000         # S3 API
KDBC_MINIO_CONSOLE_PORT=29001 # MinIO web console

# The test stack (docker-compose.test.yml) is shifted again so it can run at
# the same time as the dev stack. It could not before: its backend published
# 8001, which the dev stack's mermaid renderer was already using.
KDBC_TEST_POSTGRES_PORT=35432
KDBC_TEST_REDIS_PORT=36379
KDBC_TEST_QDRANT_PORT=36333
KDBC_TEST_BACKEND_PORT=38000

# Changing KDBC_UI_PORT changes the browser's origin, so it also feeds
# REACT_APP_API_URL, REACT_APP_WS_URL and MINIO_PROXY_BASE_URL in the compose
# files. In the dev stack the frontend is CRA's dev server, which reads those
# when the container starts -- `make restart` is enough. The PRODUCTION image
# (frontend/Dockerfile) inlines them at BUILD time instead, so there a port
# change means rebuilding the frontend image, not just restarting it.
#
# The backend's allowed CORS origins are a separate setting,
# CORS_ALLOWED_ORIGINS in backend/.env; its default already covers this port.

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Used by docker-compose.override.yml. Backend settings live in backend/.env.
DEEPSEEK_API_KEY=
