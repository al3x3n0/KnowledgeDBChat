# react-scripts 5.0.1 declares `peerOptional typescript@"^3.2.1 || ^4"` and this
# project is on TypeScript 5.x, so npm's strict peer resolution refuses to
# install: `npm ci` fails outright with ERESOLVE. node_modules here has always
# been built with legacy resolution; this makes that explicit and identical in
# CI, which is where it first surfaced -- the workflow existed only on a
# feature branch, so `npm ci` had never actually run.
legacy-peer-deps=true
