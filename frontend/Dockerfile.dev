# Development Dockerfile for React frontend
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev dependencies for development).
# --legacy-peer-deps for the same reason as frontend/Dockerfile: react-scripts@5
# pins a typescript peer this project has outgrown, so a plain `npm ci` fails
# ERESOLVE.
RUN npm ci --legacy-peer-deps

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Start development server
CMD ["npm", "start"]

