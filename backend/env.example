# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/knowledge_db
REDIS_URL=redis://localhost:6379/0

# LLM Configuration
# Provider: 'ollama' (local), 'deepseek', 'openai', 'anthropic', 'qwen', 'kimi'
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=llama2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# DeepSeek (optional, only if LLM_PROVIDER=deepseek)
# Note: Using DeepSeek sends data to an external API. Enable only if allowed.
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-pro   # or deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RESPONSE_TOKENS=2000

# OpenAI (optional, only if LLM_PROVIDER=openai or per-user override)
# Note: Sends data to an external API. Enable only if allowed.
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (optional, only if LLM_PROVIDER=anthropic or per-user override)
# Note: Sends data to an external API. Enable only if allowed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_PROMPT_CACHE_ENABLED=true

# Qwen via DashScope compatible mode (optional)
# Note: Sends data to an external API. Enable only if allowed.
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# Kimi / Moonshot AI (optional)
# Note: Sends data to an external API. Enable only if allowed.
KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_API_KEY=
KIMI_MODEL=kimi-latest

# Native tool-calling loop in the agent think phase (opt-in; per-job override
# via job config key `native_tool_loop`). Best with capable models.
AGENT_NATIVE_TOOL_LOOP_ENABLED=false
AGENT_NATIVE_TOOL_LOOP_MAX_TOOL_CALLS=5
AGENT_NATIVE_TOOL_LOOP_MAX_LLM_CALLS=6

# LLM call snapshots for replay/debugging (stores full prompts + responses
# in llm_call_snapshots; read via GET /api/v1/llm-snapshots?job_id=...)
LLM_CALL_SNAPSHOT_ENABLED=false
LLM_CALL_SNAPSHOT_MAX_CHARS=20000

# Automatic context compaction for agent jobs (per-job override via job
# config key `auto_compaction`)
AGENT_AUTO_COMPACTION_ENABLED=true
AGENT_AUTO_COMPACTION_THRESHOLD_CHARS=60000
AGENT_AUTO_COMPACTION_KEEP_RECENT_ACTIONS=5
AGENT_AUTO_COMPACTION_MIN_ITERATIONS_BETWEEN=3

# RAG Configuration
RAG_HYBRID_SEARCH_ENABLED=true
RAG_HYBRID_SEARCH_ALPHA=0.7
RAG_RERANKING_ENABLED=true
RAG_RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RERANKING_TOP_K=5
RAG_MAX_CONTEXT_TOKENS=4000
RAG_MIN_RELEVANCE_SCORE=0.3
RAG_CHUNKING_STRATEGY=semantic
RAG_QUERY_EXPANSION_ENABLED=true
RAG_MMR_ENABLED=true
RAG_MMR_LAMBDA=0.5
RAG_DEDUPLICATION_ENABLED=true
RAG_DEDUPLICATION_THRESHOLD=0.95

# ChromaDB Configuration (only if VECTOR_STORE_PROVIDER=chroma)
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=knowledge_base

# Vector Store Provider
# VECTOR_STORE_PROVIDER can be:
# - chroma  (embedded)
# - qdrant  (service)
VECTOR_STORE_PROVIDER=qdrant

# Qdrant (only if VECTOR_STORE_PROVIDER=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=knowledge_base

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
# Stable identifier for the currently active Ed25519 audit-signing key.
AUTONOMOUS_RND_AUDIT_SIGNING_KEY_ID=knowledgeops-ed25519-v1
# Base64/base64url raw 32-byte Ed25519 seed. Set explicitly in production.
AUTONOMOUS_RND_AUDIT_SIGNING_PRIVATE_KEY=
# Exact comma-separated internal hostnames allowed for registered external systems.
EXTERNAL_GATEWAY_PRIVATE_HOST_ALLOWLIST=
# Launching an evaluation suite fans out into unattended agent jobs; opt-in only.
AUTONOMOUS_RND_EVAL_LAUNCH_ENABLED=false
# Hard cap on trial jobs created by a single launch.
AUTONOMOUS_RND_EVAL_MAX_TRIAL_JOBS=30
AUTONOMOUS_RND_EVAL_TRIAL_MAX_ITERATIONS=25
AUTONOMOUS_RND_EVAL_TRIAL_MAX_RUNTIME_MINUTES=30
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Configuration
DEBUG=True
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Data Sources Configuration
GITLAB_URL=https://gitlab.company.com
GITLAB_TOKEN=your-gitlab-token
CONFLUENCE_URL=https://company.atlassian.net
CONFLUENCE_USER=your-username
CONFLUENCE_API_TOKEN=your-api-token

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE=./data/logs/app.log

# Summarization
# Threshold above which summarization is treated as heavy and routed to DeepSeek if configured
SUMMARIZATION_HEAVY_THRESHOLD_CHARS=30000
# Per-chunk size and overlap for chunked document summaries
SUMMARIZATION_CHUNK_SIZE_CHARS=12000
SUMMARIZATION_CHUNK_OVERLAP_CHARS=800

# LaTeX Studio (disabled by default)
LATEX_COMPILER_ENABLED=false
LATEX_COMPILER_ADMIN_ONLY=true
LATEX_COMPILER_TIMEOUT_SECONDS=20
LATEX_COMPILER_MAX_SOURCE_CHARS=200000
LATEX_PROJECT_MAX_FILE_SIZE=26214400
LATEX_COMPILER_RUN_BIBTEX=true
LATEX_COMPILER_USE_CELERY=false
LATEX_COMPILER_CELERY_QUEUE=latex
LATEX_COMPILER_JOB_QUEUED_STALE_SECONDS=600
LATEX_COMPILER_JOB_RUNNING_STALE_SECONDS=300

# Kroki (Mermaid diagram rendering)
# Local Kroki Docker container for diagram rendering
KROKI_URL=http://localhost:8001
# External fallback if local is unavailable
KROKI_FALLBACK_URL=https://kroki.io
# Enable fallback to external service
KROKI_USE_FALLBACK=true

# Custom Tools
# Docker container tools require access to a Docker daemon; keep disabled by default.
CUSTOM_TOOL_DOCKER_ENABLED=false

# Agent governance (writes)
# Allow autonomous agent jobs to directly apply patch diffs to KB documents.
# Strongly recommended to keep disabled and use PatchPR review/merge instead.
AGENT_KB_PATCH_APPLY_ENABLED=false

# LDAP (optional)
# Enable LDAP login + optional admin import for existing directory users.
LDAP_ENABLED=false
LDAP_URI=ldap://ldap.example.com:389
LDAP_START_TLS=false
LDAP_INSECURE_SKIP_TLS_VERIFY=false
LDAP_CONNECT_TIMEOUT_SECONDS=8

# Service account for searching users (recommended for AD)
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# Base DN and user lookup
LDAP_BASE_DN=dc=example,dc=com
# Option A: direct user DN template (no service account needed)
LDAP_USER_DN_TEMPLATE=uid={username},ou=People,dc=example,dc=com
# Option B: search filter (requires LDAP_BIND_DN)
LDAP_USER_SEARCH_FILTER=(|(uid={username})(sAMAccountName={username})(userPrincipalName={username}))
LDAP_IMPORT_FILTER=(|(objectClass=person)(objectClass=inetOrgPerson)(objectClass=user))

# Attribute mapping
LDAP_USERNAME_ATTRIBUTE=uid
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_FULL_NAME_ATTRIBUTE=displayName
LDAP_GROUPS_ATTRIBUTE=memberOf
LDAP_DEFAULT_EMAIL_DOMAIN=
LDAP_USER_ATTRIBUTES=uid,sAMAccountName,userPrincipalName,mail,cn,displayName,memberOf

# Role mapping by group DN (comma-separated)
LDAP_ADMIN_GROUP_DNS=
LDAP_VIEWER_GROUP_DNS=

# Provisioning behavior
LDAP_SYNC_ON_LOGIN=true
LDAP_CREATE_USER_ON_LOGIN=true

# Transcription (optional advanced filters)
TRANSCRIPTION_FILTER_INTRO_JUNK=true
TRANSCRIPTION_INTRO_MAX_SECONDS=12
TRANSCRIPTION_INTRO_NO_SPEECH_PROB=0.30
TRANSCRIPTION_SKIP_INITIAL_SECONDS=0
